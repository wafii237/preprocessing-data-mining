    "# ============================================================\n",
    "# SEL 1 - MEMBACA DATA\n",
    "# Jalankan sel ini, lalu klik \"Choose Files\" dan pilih file CSV/Excel Anda.\n",
    "# ============================================================\n",
    "import csv\n",
    "import re\n",
    "import warnings\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from google.colab import files\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "pd.set_option(\"display.max_columns\", 50)\n",
    "pd.set_option(\"display.width\", 200)\n",
    "pd.set_option(\"display.max_colwidth\", 60)\n",
    "\n",
    "# ---------- Pengaturan (ubah bila perlu) ----------\n",
    "SHEET_PILIHAN = 0      # nomor sheet (mulai 0) atau nama sheet. Hanya dipakai untuk file Excel.\n",
    "BARIS_HEADER = None    # isi nomor baris header (mulai 0) jika deteksi otomatis salah. None = otomatis.\n",
    "\n",
    "# ---------- Unggah file ----------\n",
    "uploaded = files.upload()\n",
    "NAMA_FILE = next(iter(uploaded))\n",
    "ekstensi = Path(NAMA_FILE).suffix.lower()\n",
    "print(\"File:\", NAMA_FILE, \"| format:\", ekstensi)\n",
    "\n",
    "catatan = []   # daftar catatan perubahan (dipakai di akhir untuk sheet Excel)\n",
    "\n",
    "\n",
    "def catat(langkah, kolom, jumlah, keterangan):\n",
    "    \"\"\"Simpan satu baris catatan perubahan.\"\"\"\n",
    "    catatan.append({\"langkah\": langkah, \"kolom\": kolom, \"jumlah\": jumlah, \"keterangan\": keterangan})\n",
    "\n",
    "\n",
    "# ---------- Baca file mentah TANPA header dulu (semua sebagai teks) ----------\n",
    "# Alasannya: agar angka nol di depan tidak hilang dan kita bisa mencari baris header yang benar.\n",
    "if ekstensi in (\".xlsx\", \".xlsm\", \".xls\"):\n",
    "    xl = pd.ExcelFile(NAMA_FILE)\n",
    "    print(\"Daftar sheet:\", {i: nama for i, nama in enumerate(xl.sheet_names)})\n",
    "    sheet = xl.sheet_names[SHEET_PILIHAN] if isinstance(SHEET_PILIHAN, int) else SHEET_PILIHAN\n",
    "    print(\"Sheet yang dipakai:\", sheet, \"(ubah SHEET_PILIHAN di atas untuk sheet lain)\")\n",
    "    mentah = pd.read_excel(NAMA_FILE, sheet_name=sheet, header=None, dtype=str)\n",
    "elif ekstensi in (\".csv\", \".txt\"):\n",
    "    # Cek encoding dan pemisah (koma, titik koma, tab, atau |)\n",
    "    for enc in (\"utf-8-sig\", \"latin-1\"):\n",
    "        try:\n",
    "            contoh = open(NAMA_FILE, encoding=enc).read(5000)\n",
    "            break\n",
    "        except UnicodeDecodeError:\n",
    "            continue\n",
    "    try:\n",
    "        sep = csv.Sniffer().sniff(contoh, delimiters=\",;\\t|\").delimiter\n",
    "    except csv.Error:\n",
    "        sep = \",\"\n",
    "    print(f\"Encoding: {enc} | pemisah kolom terdeteksi: {sep!r}\")\n",
    "    mentah = pd.read_csv(NAMA_FILE, sep=sep, encoding=enc, header=None, dtype=str,\n",
    "                         keep_default_na=False, na_values=[\"\"])\n",
    "else:\n",
    "    raise ValueError(\"Format file tidak didukung. Gunakan CSV atau Excel.\")\n",
    "\n",
    "# ---------- Cari baris header ----------\n",
    "# Header = baris pertama yang terisi hampir penuh (judul file biasanya hanya 1-2 sel terisi).\n",
    "if BARIS_HEADER is None:\n",
    "    terisi = mentah.head(20).notna().sum(axis=1)\n",
    "    BARIS_HEADER = int(terisi[terisi >= 0.7 * terisi.max()].index[0])\n",
    "print(\"Baris header (mulai dari 0):\", BARIS_HEADER)\n",
    "if BARIS_HEADER > 0:\n",
    "    print(\"Baris di atas header (judul/keterangan file):\")\n",
    "    print(mentah.iloc[:BARIS_HEADER].dropna(how=\"all\").to_string(header=False, index=False))\n",
    "\n",
    "df = mentah.iloc[BARIS_HEADER + 1:].copy()\n",
    "df.columns = [str(c) for c in mentah.iloc[BARIS_HEADER]]\n",
    "df = df.reset_index(drop=True)\n",
    "\n",
    "# Simpan salinan data asli (tidak diubah sampai akhir)\n",
    "df_asli = df.copy()\n",
    "print(\"\\nUkuran data awal:\", df.shape)"
   ]
