    "## 6. Duplikasi dan outlier\n",
    "Menghapus hanya duplikat penuh. Outlier dideteksi dengan IQR tetapi tidak dihapus."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "2486b266",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# SEL 6 - DUPLIKASI DAN OUTLIER\n",
    "# ============================================================\n",
    "# 6a. Duplikasi pencatatan: baris yang SEMUA isinya sama (kecuali ID urut seperti 'No.').\n",
    "#     Itu hampir pasti input ganda, jadi dihapus (baris pertama dipertahankan).\n",
    "kol_dup = [c for c in df.columns if c in kol_cek_dup or c.endswith(\"_perlu_dicek\")]\n",
    "dup = df.duplicated(subset=kol_dup)\n",
    "print(\"Duplikat penuh ditemukan:\", int(dup.sum()))\n",
    "if dup.any():\n",
    "    print(\"Baris yang dihapus:\")\n",
    "    display(df[dup])\n",
    "    df = df[~dup].reset_index(drop=True)\n",
    "    catat(\"Duplikasi\", \"(baris)\", int(dup.sum()),\n",
    "          \"Menghapus baris yang seluruh isinya sama (selain ID urut); baris pertama dipertahankan\")\n",
    "\n",
    "# Pengamatan berulang yang SAH (nama sama tapi lokasi/isi beda) tidak dihapus.\n",
    "if kol_teks:\n",
    "    k0 = kol_teks[0]\n",
    "    n_ulang = int(df.duplicated(subset=[k0], keep=False).sum())\n",
    "    print(f\"\\n'{k0}' berulang pada {n_ulang} baris dengan isi berbeda -> dipertahankan sebagai pengamatan sah.\")\n",
    "    catat(\"Duplikasi\", k0, n_ulang, \"Nilai berulang dengan isi baris berbeda dipertahankan (bukan duplikasi pencatatan)\")\n",
    "\n",
    "# 6b. Outlier dengan IQR. Hanya untuk kolom numerik murni (bukan ID/kode/kategori).\n",
    "#     Jika data tidak punya kolom numerik, kita buat kolom turunan berupa JUMLAH kode\n",
    "#     pada kolom kode yang berisi banyak kode sekaligus (mis. jumlah KBLI per perusahaan).\n",
    "kol_iqr = list(kol_num)\n",
    "for c in kol_id:\n",
    "    banyak = df[c].dropna().str.count(r\"[,;/ ]+\").gt(0).mean()\n",
    "    if banyak > 0.05:                      # >5% baris berisi lebih dari satu kode\n",
    "        nama_baru = \"jumlah_\" + re.sub(r\"\\W+\", \"_\", c.lower()).strip(\"_\")\n",
    "        df[nama_baru] = df[c].fillna(\"\").apply(lambda t: len([x for x in re.split(r\"[,;/ ]+\", t) if x]))\n",
    "        kol_iqr.append(nama_baru)\n",
    "        kol_num.append(nama_baru)\n",
    "        catat(\"Kolom turunan\", nama_baru, len(df), f\"Jumlah kode pada kolom '{c}' (dipakai untuk memeriksa outlier)\")\n",
    "\n",
    "hasil_iqr = []\n",
    "for c in kol_iqr:\n",
    "    q1, q3 = df[c].quantile([0.25, 0.75])\n",
    "    iqr = q3 - q1\n",
    "    bawah, atas = q1 - 1.5 * iqr, q3 + 1.5 * iqr\n",
    "    n_out = int(((df[c] < bawah) | (df[c] > atas)).sum())\n",
    "    hasil_iqr.append({\"kolom\": c, \"Q1\": q1, \"Q3\": q3, \"batas_bawah\": bawah, \"batas_atas\": atas,\n",
    "                      \"min\": df[c].min(), \"max\": df[c].max(), \"jumlah_outlier\": n_out,\n",
    "                      \"persen\": round(100 * n_out / len(df), 2),\n",
    "                      \"catatan\": \"IQR = 0: lebih dari 75% nilai sama, semua nilai di atasnya otomatis terhitung outlier (hanya indikasi)\" if iqr == 0 else \"\"})\n",
    "if hasil_iqr:\n",
    "    ringkasan_outlier = pd.DataFrame(hasil_iqr)\n",
    "    print(\"\\nRingkasan outlier (IQR 1,5x):\")\n",
    "    display(ringkasan_outlier)\n",
    "    print(\"Outlier TIDAK dihapus atau dibatasi. Nilai ekstrem belum tentu salah \"\n",
    "          \"(misalnya perusahaan yang memang punya banyak KBLI). Perlu keputusan sesuai tujuan analisis.\")\n",
    "    for r in hasil_iqr:\n",
    "        catat(\"Outlier\", r[\"kolom\"], r[\"jumlah_outlier\"], \"Hanya dideteksi dengan IQR; tidak dihapus/dibatasi\")\n",
    "else:\n",
    "    ringkasan_outlier = pd.DataFrame()\n",
    "    print(\"\\nTidak ada kolom numerik yang sesuai untuk IQR (ID/kode tidak diperiksa).\")"
