    "## 4. Membersihkan dan memperbaiki format\n",
    "Merapikan spasi, menyamakan penulisan kategori yang jelas sama, menjaga kode tetap teks, dan mengonversi angka/tanggal bila ada."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "674b7749",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# SEL 4 - MEMBERSIHKAN DAN MEMPERBAIKI FORMAT\n",
    "# ============================================================\n",
    "# 4a. Rapikan spasi pada nilai teks (spasi di awal/akhir dan spasi ganda).\n",
    "#     Teks kosong (\"\") diubah menjadi NaN karena maknanya jelas: tidak ada isi.\n",
    "for c in df.columns:\n",
    "    asli = df[c]\n",
    "    baru = asli.where(asli.isna(), asli.astype(str).str.replace(r\"\\s+\", \" \", regex=True).str.strip())\n",
    "    baru = baru.replace(\"\", np.nan)\n",
    "    n_ubah = int(((asli != baru) & ~(asli.isna() & baru.isna())).sum())\n",
    "    if n_ubah:\n",
    "        catat(\"Format\", c, n_ubah, \"Merapikan spasi berlebih / mengubah teks kosong menjadi NaN\")\n",
    "    df[c] = baru\n",
    "n_spasi = sum(r[\"jumlah\"] for r in catatan if r[\"langkah\"] == \"Format\" and \"spasi\" in r[\"keterangan\"])\n",
    "print(f\"Spasi berlebih / teks kosong dirapikan pada {n_spasi} sel.\" if n_spasi else \"Tidak ada spasi berlebih atau teks kosong yang perlu dirapikan.\")\n",
    "\n",
    "# 4b. Samakan penulisan kategori HANYA jika jelas sama\n",
    "#     (beda huruf besar/kecil dan spasi saja). Dipakai ejaan yang paling sering muncul.\n",
    "#     Nama, alamat, dan teks bebas lain TIDAK diubah.\n",
    "POLA_KOLOM_JENIS = r\"bidang|jenis|kategori|sektor|produk\"\n",
    "kol_seragam = kol_kat + [c for c in kol_teks if re.search(POLA_KOLOM_JENIS, c.lower())]\n",
    "\n",
    "\n",
    "def samakan_penulisan(s):\n",
    "    kunci = s.str.lower()\n",
    "    ejaan_utama = s.groupby(kunci).agg(lambda x: x.value_counts().idxmax())\n",
    "    return kunci.map(ejaan_utama).where(s.notna(), np.nan)\n",
    "\n",
    "\n",
    "for c in kol_seragam:\n",
    "    sebelum = df[c].nunique()\n",
    "    baru = df[c].copy()\n",
    "    mask = baru.notna()\n",
    "    baru[mask] = samakan_penulisan(baru[mask])\n",
    "    n_ubah = int((baru[mask] != df.loc[mask, c]).sum())\n",
    "    if n_ubah:\n",
    "        catat(\"Konsistensi\", c, n_ubah,\n",
    "              f\"Menyeragamkan huruf besar/kecil: {sebelum} -> {baru.nunique()} nilai unik (memakai ejaan terbanyak)\")\n",
    "        print(f\"{c}: {sebelum} -> {baru.nunique()} nilai unik ({n_ubah} sel diseragamkan)\")\n",
    "    df[c] = baru\n",
    "\n",
    "# 4c. Kolom ID/kode: tetap berupa TEKS (agar angka nol di depan tidak hilang).\n",
    "#     Hanya membuang \".0\" akibat Excel, mis. '10750.0' -> '10750'.\n",
    "for c in kol_id:\n",
    "    s = df[c]\n",
    "    baru = s.str.replace(r\"\\.0$\", \"\", regex=True)\n",
    "    n_ubah = int((s.fillna(\"\") != baru.fillna(\"\")).sum())\n",
    "    if n_ubah:\n",
    "        catat(\"Format\", c, n_ubah, \"Membuang akhiran '.0' pada kode (artefak angka Excel); tetap bertipe teks\")\n",
    "    df[c] = baru\n",
    "\n",
    "    # Tandai nilai kode yang formatnya tidak lazim (mis. '10763.4631'). Nilai asli TIDAK diubah,\n",
    "    # karena maknanya belum pasti (bisa salah ketik pemisah desimal/koma).\n",
    "    tidak_lazim = df[c].fillna(\"\").str.contains(r\"[^0-9,;/ ]\", regex=True)\n",
    "    if tidak_lazim.any():\n",
    "        df[c + \"_perlu_dicek\"] = tidak_lazim\n",
    "        catat(\"Validasi\", c, int(tidak_lazim.sum()),\n",
    "              f\"Ditandai di kolom '{c}_perlu_dicek' (berisi karakter selain angka/pemisah). Nilai asli dipertahankan\")\n",
