    "\n",
    "# 2d. Identifikasi jenis kolom (otomatis, boleh dikoreksi manual di bawah)\n",
    "POLA_KODE = r\"(^no\\.?$|^id$|\\bid\\b|kode|kbli|nik|npwp|telp|telepon|\\bhp\\b|pos|nomor|nip)\"\n",
    "POLA_TANGGAL = r\"^\\d{1,4}[-/]\\d{1,2}[-/]\\d{1,4}\"\n",
    "\n",
    "\n",
    "def angka_atau_nan(s):\n",
    "    \"\"\"Ubah teks ke angka, mengenali format Indonesia (1.234,56), Rp, %, dan spasi.\"\"\"\n",
    "    t = s.astype(str).str.strip().str.replace(r\"(?i)rp\\.?|%|\\s\", \"\", regex=True)\n",
