    "# ============================================================\n",
    "# SEL 8 - VALIDASI HASIL (semua angka dihitung dari data, bukan ditulis manual)\n",
    "# ============================================================\n",
    "def ringkas_kondisi(d, kol_cek):\n",
    "    kol_ada = [c for c in kol_cek if c in d.columns]\n",
    "    n_num = sum(pd.api.types.is_numeric_dtype(t) and not pd.api.types.is_bool_dtype(t) for t in d.dtypes)\n",
    "    n_tgl = sum(pd.api.types.is_datetime64_any_dtype(t) for t in d.dtypes)\n",
    "    n_bool = sum(pd.api.types.is_bool_dtype(t) for t in d.dtypes)\n",
    "    return {\n",
    "        \"jumlah_baris\": len(d),\n",
    "        \"jumlah_kolom\": d.shape[1],\n",
    "        \"total_missing\": int(d.isna().sum().sum()),\n",
    "        \"baris_duplikat\": int(d.duplicated(subset=kol_ada).sum()),\n",
    "        \"kolom_teks\": d.shape[1] - n_num - n_tgl - n_bool,\n",
    "        \"kolom_numerik\": n_num,\n",
    "        \"kolom_tanggal\": n_tgl,\n",
    "        \"kolom_boolean(penanda)\": n_bool,\n",
    "    }\n",
    "\n",
    "\n",
    "perbandingan = pd.DataFrame({\n",
    "    \"file_mentah\": ringkas_kondisi(df_asli, kol_cek_dup),          # termasuk judul, catatan kaki, tabel samping\n",
