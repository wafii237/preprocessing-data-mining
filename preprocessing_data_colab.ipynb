   "outputs": [],
   "source": [
    "# ============================================================\n",
    "# SEL 5 - MENANGANI MISSING VALUE\n",
    "# Aturan: numerik -> median | kategori -> \"Tidak diketahui\"\n",
    "#         ID/kode, tanggal, teks bebas -> TIDAK diisi (hanya dilaporkan)\n",
    "# ============================================================\n",
    "total_kosong = int(df.isna().sum().sum())\n",
    "print(\"Total sel kosong saat ini:\", total_kosong)\n",
    "\n",
    "kosong_per_kolom = df.isna().sum()\n",
    "kosong_per_kolom = kosong_per_kolom[kosong_per_kolom > 0]\n",
    "\n",
    "if kosong_per_kolom.empty:\n",
    "    print(\"Tidak ada missing value, jadi tidak ada yang perlu diisi.\")\n",
    "else:\n",
    "    for c, n in kosong_per_kolom.items():\n",
    "        if c in kol_num:\n",
    "            nilai = df[c].median()\n",
    "            df[c] = df[c].fillna(nilai)\n",
    "            catat(\"Missing value\", c, int(n), f\"Diisi median = {nilai:g} (kolom numerik; median tahan terhadap outlier)\")\n",
    "        elif c in kol_kat:\n",
    "            df[c] = df[c].fillna(\"Tidak diketahui\")\n",
    "            catat(\"Missing value\", c, int(n), \"Diisi 'Tidak diketahui' (kategori; tidak menebak nilai)\")\n",
    "        else:\n",
    "            catat(\"Missing value\", c, int(n), \"Dibiarkan kosong (ID/kode/tanggal/teks bebas tidak diisi sembarangan)\")\n",
    "        print(f\"{c}: {int(n)} kosong -> {catatan[-1]['keterangan']}\")\n",
    "\n",
    "# Penanda nilai hilang yang ditemukan di Sel 3: dijelaskan, tidak diganti otomatis\n",
    "if len(penanda) and (penanda[\"penanda\"] != \"(teks kosong)\").any():\n",
    "    print(\"\\nCatatan tentang penanda yang ditemukan di Sel 3 (tidak diganti otomatis):\")\n",
    "    for _, r in penanda[penanda[\"penanda\"] != \"(teks kosong)\"].iterrows():\n",
    "        print(f\"- Kolom '{r['kolom']}': {r['penanda']} sebanyak {r['jumlah']} baris.\")\n",
    "    print(\"  Nilai ini bermakna jelas (status 'belum melapor'), bukan sel yang rusak, jadi dipertahankan \"\n",
    "          \"sebagai kategori tersendiri. Jangan diisi dengan modus karena itu akan menebak data yang belum dilaporkan.\")\n",
    "    catat(\"Missing value\", \"penanda teks\", int(penanda.loc[penanda[\"penanda\"] != \"(teks kosong)\", \"jumlah\"].sum()),\n",
    "          \"Penanda seperti 'Belum Melapor' dipertahankan sebagai kategori sah (tidak diimputasi)\")"
